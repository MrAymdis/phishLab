{
  "manifest_version": 3,
  "name": "PhishLab 邮件举报",
  "version": "1.1.0",
  "description": "一键将可疑邮件提交至 PhishLab 安全平台（自动采集当前邮件合成 EML 归档，配置由管理员导出的 JSON 导入）",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-64.png",
    "128": "icons/icon-80.png"
  },
  "action": {
    "default_icon": "icons/icon-32.png",
    "default_title": "PhishLab 邮件举报",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["eml.js", "adapters.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
