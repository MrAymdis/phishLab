# ===== 应用 =====
APP_NAME=PhishLab
ENV=dev
# JWT 签名密钥，生产必须修改
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars

# ===== MySQL =====
DATABASE_URL=mysql+pymysql://phishlab:phishlab@127.0.0.1:3306/phishlab?charset=utf8mb4

# ===== Redis（缓存 / Celery broker / 事件流） =====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== JWT =====
JWT_EXPIRE_MINUTES=720

# ===== CORS 白名单（JSON 数组；生产收紧为前端域名，勿留 *）=====
CORS_ORIGINS=["*"]

# ===== 敏感字段 AES-GCM 密钥（32 字节 base64；留空则开发环境从 SECRET_KEY 派生，生产必须显式配置或接 KMS）=====
AES_KEY_B64=

# ===== MinIO =====
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ===== 追踪 / 落地页独立域名（严禁与主平台同域）=====
TRACK_BASE_URL=https://t.phish-example.com
LANDING_BASE_URL=https://p.phish-example.com

# ===== ChatBI 独立只读账号 DSN（红线 5，生产必配；留空则主库 + 事务级只读兜底）=====
# 建号：GRANT SELECT ON phishlab.* TO 'phishlab_ro'@'%' IDENTIFIED BY '<强密码>';
CHATBI_READONLY_DSN=
