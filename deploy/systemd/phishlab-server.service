# PhishLab 主平台 API（无 Docker 裸机部署）
# 安装：cp 到 /etc/systemd/system/，按实际路径修改 ExecStart/WorkingDirectory，然后
#   systemctl daemon-reload && systemctl enable --now phishlab-server
[Unit]
Description=PhishLab 主平台 API (uvicorn)
After=network.target mysql.service redis-server.service

[Service]
Type=simple
User=phishlab
Group=phishlab
WorkingDirectory=/opt/phishlab/server
ExecStart=/opt/phishlab/server/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
